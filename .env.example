NODE_ENV=dev

APP_NAME='Test Fastify Api'
APP_VERSION=v1.0.0
APP_PORT=3000

LOGGER_LEVEL=info
LOGGER_TRANSPORT_TARGET=pino-pretty

JWT_SECRET=change_me_to_a_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=604800

PROJECT_NAME=fastify

PGSQL_VERSION=postgres:16
DB_NAME=fastify_db
DB_USER=fastify_user
DB_PASS=fastify_pass

DATABASE_URL="postgres://fastify_user:fastify_pass@localhost:5232/fastify_db?schema=public"

ADMINER_VERSION=adminer:5.4.2
ADMINER_PORT=795

REDIS_HOST=127.0.0.1
REDIS_PORT=6579
REDIS_PASS=123

GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=your_secure_password